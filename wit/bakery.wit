/// @dist_gen(version = 1)
package example:bakery;

/// Shared types used by the other interfaces.
interface types {
    /// A weight in grams. @dist_gen(unit = "g")
    type grams = u32;

    /// @dist_gen(serializable)
    record ingredient {
        /// @dist_gen(key)
        name: string,
        grams: grams,
    }

    enum crust {
        soft,
        /// @dist_gen(default)
        crispy,
    }

    record loaf {
        name: string,
        weight-grams: grams,
    }
}

/// Storage of raw ingredients.
interface pantry {
    use types.{ingredient, grams};

    /// An alias of an alias: resolves through `grams` to `u32`.
    type stock-level = grams;

    /// How many grams of an ingredient are in stock.
    /// @dist_gen(idempotent, timeout = 10, remote = "storage-room")
    stock: func(name: string) -> stock-level;

    /// Take an ingredient out of the pantry, if enough is available.
    take: func(name: string, amount: grams) -> option<ingredient>;
}

/// Turns a list of ingredients into bread.
/// @dist_gen(remote = "back-kitchen")
interface oven {
    /// `loaf` is renamed to `bread` inside this interface.
    use types.{ingredient, loaf as bread};

    /// A tin that holds dough while it rises.
    /// @dist_gen(stateful)
    resource baking-tin {
        constructor(size: u32);
        /// @dist_gen(idempotent)
        fill: func(ingredients: list<ingredient>);
        is-full: func() -> bool;
        /// @dist_gen(cached)
        largest: static func() -> u32;
    }

    /// Bakes the ingredients. @dist_gen(timeout = 60) @dist_gen(retries(max = 3), label = "a (b)")
    bake: async func(ingredients: list<ingredient>, minutes: u32, celsius: u32) -> result<bread, string>;
}

/// Knows which ingredients a bread needs.
interface recipes {
    use types.{ingredient};

    list-recipes: func() -> list<string>;
    ingredients-for: func(recipe: string) -> option<list<ingredient>>;
}

/// @dist_gen(entry)
/// A baker uses the pantry and oven, and shares the recipes it knows.
world baker {
    import pantry;
    /// @dist_gen(optional)
    import oven;

    /// An anonymous interface declared inline in the world.
    import scale: interface {
        weigh: func(ingredient: string) -> u32;
    }

    /// Loose functions declared directly in the world.
    /// @dist_gen(local)
    import note: func(message: string);
    export loaves-baked: async func() -> u32;

    export recipes;
}

/// A shop looks up recipes and provides the pantry and oven.
world shop {
    import recipes;
    export pantry;
    export oven;
}
